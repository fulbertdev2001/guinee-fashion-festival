{
  "name": "guinee-fashion-festival",
  "version": "1.0.0",
  "description": "Site Guinée Fashion Festival — Mode & Artisanat (React + Express + SQLite)",
  "main": "app.js",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"node --watch server/index.js\" \"vite\"",
    "build": "node build.js",
    "build:client": "vite build",
    "start": "node app.js",
    "seed": "node server/seed.js",
    "seed:reset": "node server/seed.js --reset"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.10.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "framer-motion": "^11.18.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lenis": "^1.3.27",
    "multer": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "vite": "^5.4.21"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}

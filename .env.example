PORT=3000
NODE_ENV=production
# Chaîne longue et aléatoire (obligatoire en production)
JWT_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire
# Premier compte administrateur (créé au premier démarrage si aucun compte n'existe)
ADMIN_EMAIL=admin@guineefashionfestival.com
ADMIN_PASSWORD=ChangeMoi!2026
# Dossier des données (base SQLite + médias + candidatures)
DATA_DIR=data
# Taille max d'une vidéo envoyée depuis l'admin (Mo)
MAX_VIDEO_MB=600

# ---------- E-mails (réponses aux messages + newsletter) ----------
# Se configure directement dans l'admin : « E-mails (SMTP) » (serveur, identifiant, mot de passe, expéditeur, test d'envoi).
# Les variables ci-dessous sont facultatives : elles ne servent que de valeurs de secours si rien n'est saisi dans l'admin.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=contact@votre-domaine.com
# SMTP_PASS=
# MAIL_FROM="Guinée Fashion Festival <contact@votre-domaine.com>"
# SITE_URL=https://www.votre-domaine.com
# true = n'envoie rien, enregistre les e-mails dans private/outbox (pour tester)
# MAIL_DRY_RUN=false

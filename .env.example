PORT=3000
NODE_ENV=production
# Chaîne longue et aléatoire (obligatoire en production)
JWT_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire
# Premier compte administrateur (créé au premier démarrage si aucun compte n'existe)
ADMIN_EMAIL=admin@guineefashionfestival.com
ADMIN_PASSWORD=ChangeMoi!2026
# Dossier des données (base SQLite + médias + candidatures)
DATA_DIR=data
# Taille max d'une vidéo envoyée depuis l'admin (Mo)
MAX_VIDEO_MB=600
